# Copy to .env and fill in. Never commit .env.
# Test-mode keys only. Live keys (rzp_live_*) are refused by the client.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Optional. Empty = rules-only diagnosis (ambiguous cases escalate).
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# If true, no recovery action executes (checked by policy and the executor).
KILL_SWITCH=false

# Optional. Default is data/payrecover.db
# DB_PATH=data/payrecover.db

# Optional overrides (seconds / attempt count).
RAZORPAY_TIMEOUT_SECONDS=10
RAZORPAY_READ_RETRIES=3
